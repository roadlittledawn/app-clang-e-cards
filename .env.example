# Auth.js
NEXTAUTH_SECRET=           # Generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MongoDB Atlas (https://cloud.mongodb.com)
MONGODB_URI=               # e.g. mongodb+srv://user:pass@cluster.mongodb.net/ecards

# AWS S3 (https://console.aws.amazon.com)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Giphy (https://developers.giphy.com) — server-side only, never exposed to client
GIPHY_API_KEY=

# Admin seed (used once to create the admin account — see scripts/seed-admin.ts)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
